@@ -372,6 +372,32 @@ static void test_triangle_strip(void)
     }
 }
 
+/* A vertex on the camera plane: clip (0,0,0,0). Both edges to the rim
+ * vertices project to the same points, so the triangle has no screen area and
+ * the DS stores no polygon. Leaving it to the software rasteriser (which took
+ * screen (0,0) literally) fanned the title's left wing out of the corner. */
+static void test_camera_plane_triangle(void)
+{
+    static const uint32_t proj[16]={10713,0,0,0, 0,14283,0,0,
+                                    0,0,-4096,-4096, 0,0,0,0};
+    const NitroGx3dScene *scene;
+    unsigned k;
+
+    reset_geometry();
+    NitroPort_GxDirectWrite(0x10,0);                    /* projection */
+    for(k=0;k<16;k++)NitroPort_GxDirectWrite(0x16,proj[k]);
+    NitroPort_GxDirectWrite(0x10,2);                    /* position */
+    NitroPort_GxDirectWrite(0x29,(3u<<6)|(31u<<16));    /* both sides */
+    NitroPort_GxDirectWrite(0x40,0);                    /* triangles */
+    vertex(0,0,0);                                      /* at the camera */
+    vertex(-300,200,-1200);
+    vertex(300,200,-1200);
+    NitroPort_GxDirectWrite(0x41,0);
+    swap();
+    scene=NitroPort_Gx3dScene();
+    CHECK(scene->count==0);
+}
+
 static void test_box_test(void)
 {
     reset_geometry();
@@ -1802,6 +1828,7 @@ static void run_all(void)
     test_interpolation_tile_a_scene();
     test_interpolation_swaying();
     test_triangle_strip();
+    test_camera_plane_triangle();
     test_hidden_vertices();
     test_textures();
     test_box_test();
